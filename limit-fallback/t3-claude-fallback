#!/usr/bin/env python3
"""Keď týždenný Claude limit prejde PRAH % (3 % zvyšok), prepne default model T3 na Codex účet Infowork
(T3 inštancia codex_infowork; Karchi 2026-11-17), a keď má Infowork týždeň minutý, na Môj (inštancia codex);
po resete limitu vráti pôvodný. T3 si settings.json sleduje sám, zmena platí hneď pre nové vlákna.
Týždeň Codex účtov berie z limit-ping (~/.local/state/limit-ping/codex-<účet>.json, beží na asuse; iné stroje ho čítajú cez ssh asus).
Stav: ~/.local/share/t3-claude-fallback/state.json"""
import fcntl, json, math, os, subprocess, sys, time, urllib.error, urllib.request
from datetime import datetime
from email.utils import parsedate_to_datetime
from pathlib import Path

H = Path.home()
PRAH = float(os.environ.get("PRAH", 97))
SETTINGS = H / ".t3/userdata/settings.json"
STATE = H / ".local/share/t3-claude-fallback/state.json"
USAGE = H / ".local/share/t3-claude-fallback/usage.json"
# T3 inštancia -> limit-ping lane, v poradí, v akom sa skúšajú; CODEX_INSTANCE nechá len jednu.
ACCOUNTS = {"codex_infowork": "codex-infowork", "codex": "codex-moj"}
if os.environ.get("CODEX_INSTANCE"):
    ACCOUNTS = {os.environ["CODEX_INSTANCE"]: None}
LIMIT_PING = H / ".local/state/limit-ping"


def codex(instance):
    return {"instanceId": instance, "model": os.environ.get("CODEX_MODEL", "gpt-6.2-sol"),
            "options": [{"id": "reasoningEffort", "value": "high"}]}


def week_used_up(lane, now):
    """Last weekly limit limit-ping saw for this Codex account: True when it is used up and not yet reset, None when
    its state cannot be read (asus unreachable)."""
    if not lane:
        return False
    try:
        try:
            text = (LIMIT_PING / f"{lane}.json").read_text()
        except FileNotFoundError:
            text = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "asus",
                                   f"cat .local/state/limit-ping/{lane}.json"],
                                  capture_output=True, text=True, timeout=15, check=True).stdout
        week = json.loads(text)["week"]
        return float(week["used"]) >= 100 and float(week["resets"]) > now
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return None


def pick(cur):
    """The first Codex account whose week is not used up. While a state is unknown, a Codex account this automation
    already chose stays (it is not swapped back to one last seen used up)."""
    now = time.time()
    seen = {instance: week_used_up(lane, now) for instance, lane in ACCOUNTS.items()}
    if cur and None in seen.values():
        return cur
    for instance, used_up in seen.items():
        if not used_up:
            return codex(instance)
    return cur or codex(next(iter(ACCOUNTS)))  # every week used up: stay where it is


def retry_delay(value, now):
    try:
        delay = float(value)
        return max(0, delay) if math.isfinite(delay) else 0
    except (TypeError, ValueError):
        try:
            return max(0, parsedate_to_datetime(value).timestamp() - now)
        except (TypeError, ValueError, OverflowError):
            return 0


def valid_usage(value):
    return type(value) in (int, float) and math.isfinite(value) and 0 <= value <= 100


def weekly():
    # Failed usage reads never mean a reset; only this private cache changes on errors.
    USAGE.parent.mkdir(parents=True, exist_ok=True)
    with USAGE.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cached = json.loads(USAGE.read_text())
            if not isinstance(cached, dict):
                cached = {}
        except (OSError, ValueError):
            cached = {}
        now = time.time()
        if now < cached.get('next_check', 0):
            return None
        retry_after = 0
        try:
            tok = json.loads((H / ".claude/.credentials.json").read_text())["claudeAiOauth"]["accessToken"]
            req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
                "Authorization": "Bearer " + tok, "anthropic-beta": "oauth-2025-04-20"})
            with urllib.request.urlopen(req, timeout=20) as response:
                value = json.load(response)['seven_day']['utilization']
            if not valid_usage(value):
                raise ValueError('invalid usage')
        except urllib.error.HTTPError as error:
            retry_after = retry_delay(error.headers.get('Retry-After'), now) if error.headers else 0
            reason = f'HTTP {error.code}'
        except (OSError, ValueError, KeyError, TypeError):
            reason = 'usage unavailable'
        else:
            write(USAGE, {'next_check': time.time() + 1800, 'failures': 0})
            return value
        failures = min(cached.get('failures', 0) + 1, 5)
        delay = max(retry_after, min(1800 * 2 ** (failures - 1), 21600))
        write(USAGE, {'next_check': time.time() + delay, 'failures': failures})
        print(f'Claude limit: {reason}; retry in {math.ceil(delay / 60)} min; model unchanged')
        return None


def write(path, data):
    # Na mieste, nie rename: T3 sleduje práve tento súbor.
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def main():
    used = float(sys.argv[1]) if len(sys.argv) > 1 else weekly()  # argument = test bez API
    if used is None:
        return
    if not valid_usage(used):
        raise ValueError("Usage must be between 0 and 100")
    s = json.loads(SETTINGS.read_text())
    cur = s.get("defaultModelSelection") or {}
    # State: {"saved": the selection before the switch, "installed": what this automation put there}. The state of
    # the first version held only the saved selection, and it always installed Infowork with gpt-6.1-sol.
    state = json.loads(STATE.read_text()) if STATE.exists() else None
    if state and "saved" not in state:
        first = {"instanceId": "codex_infowork", "model": "gpt-6.1-sol", "options": [{"id": "reasoningEffort", "value": "high"}]}
        # 40f6402 wrote the same state and installed any of the current presets too.
        state = {"saved": state, "installed": cur if cur in [first] + [codex(i) for i in ACCOUNTS] else first}
    saved = state and state["saved"]
    ours = bool(state) and cur == state["installed"]  # only the exact selection this automation installed
    if used >= PRAH and (not state and cur.get("instanceId", "claudeAgent") == "claudeAgent" or ours):
        target = pick(cur if ours else None)
        if target == cur:
            return
        write(STATE, {"saved": saved if state else cur, "installed": target})
        s["defaultModelSelection"] = target
        write(SETTINGS, s)
        print(f"{datetime.now():%F %T} týždeň {used:.0f} % >= {PRAH:.0f} %: default -> {target['instanceId']} {target['model']}")
    elif used < PRAH and state:
        if ours:  # Restore only a selection this automation installed; none before means none after.
            if saved:
                s["defaultModelSelection"] = saved
            else:
                s.pop("defaultModelSelection", None)
            write(SETTINGS, s)
            print(f"{datetime.now():%F %T} týždeň {used:.0f} %: default späť -> {saved.get('model')}")
        else:
            print('Claude limit reset; manual model selection preserved')
        STATE.unlink()


if __name__ == "__main__":
    main()
