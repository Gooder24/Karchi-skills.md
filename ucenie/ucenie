#!/usr/bin/env bash
# ucenie: Učenie for agents (see `ucenie --help`). Runs on asus; elsewhere over ssh.
src=$HOME/ucenie/src
if [ -f "$src/server/src/cli.ts" ]; then
  bun=$HOME/.local/share/vite-plus/bin/bun
  [ -x "$bun" ] || bun=$(command -v bun)
  UCENIE_DATA="$HOME/ucenie/data" exec "$bun" run "$src/server/src/cli.ts" "$@"
fi
exec ssh -o BatchMode=yes asus "ucenie $(printf '%q ' "$@")"
