[Unit]
Description=Pull karchi-skills and relink skills and AGENTS.md
After=network-online.target

[Service]
Type=oneshot
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/timeout 60 /bin/bash %h/.work/karchi-skills/install.sh
# Runs every 3 minutes; keep the "ok" lines and systemd's start and stop lines out of the journal.
StandardOutput=null
# Errors still reach the journal (hooks/codex-hooks.mts marks its failures as warnings with <4>); a normal run prints none.
StandardError=journal
LogLevelMax=notice
